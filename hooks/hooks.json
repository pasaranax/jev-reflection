{
  "description": "Ask TypeSafe Jev to challenge Codex work and waiting decisions and trigger typed visible reflection.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "jev-reflection",
            "tool": "on_event",
            "input": {
              "event": "turn_start",
              "sessionId": "${session_id}",
              "turnId": "${turn_id}",
              "prompt": "${prompt}"
            },
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "jev-reflection",
            "tool": "on_event",
            "input": {
              "event": "tool_end",
              "sessionId": "${session_id}",
              "turnId": "${turn_id}",
              "transcriptPath": "${transcript_path}",
              "cwd": "${cwd}",
              "toolName": "${tool_name}",
              "toolInput": "${tool_input}",
              "toolResponse": "${tool_response}"
            },
            "timeout": 30
          }
        ]
      }
    ]
  }
}
